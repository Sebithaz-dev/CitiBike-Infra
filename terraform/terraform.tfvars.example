# Copia este archivo a terraform.tfvars y ajusta los valores.
# terraform.tfvars esta en .gitignore.

aws_region      = "us-east-1"
environment     = "dev"
instance_type   = "t3.large"
s3_bucket_name  = "citibike-datalake-seb-690247773624"

s3_parquet_key  = "curated/citibike_trips/citibike_dashboard_sample.parquet"
s3_model_prefix = "models/"

# Tag de las imagenes: usa el SHA del commit para trazabilidad.
image_tag = "latest"

render_health_url = "https://flask-dashboard-s3.onrender.com/health"
log_retention_days = 7
