global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    service: citibike
    environment: dev

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Dashboard Flask: /metrics expuesto por prometheus-flask-exporter.
  - job_name: dashboard
    metrics_path: /metrics
    static_configs:
      - targets: ["localhost:5000"]
        labels:
          service: flask-dashboard-s3

  # Disponibilidad de los endpoints publicos (ECS y Render).
  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://localhost:5000/health
          - __RENDER_HEALTH_URL__
          - http://localhost:3000/api/health
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9115
